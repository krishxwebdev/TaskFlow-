# Copy this to .env and fill in your values

# ---- Local Development (XAMPP) ----
# DATABASE_URL=postgresql://localhost:5432/taskflow
# (or leave blank and use individual vars below for local MySQL)

# ---- Production (set on Render dashboard, not here) ----
# DATABASE_URL is set automatically by Render when you add a PostgreSQL database

SESSION_SECRET=some_long_random_secret_string_change_this
PORT=5000
NODE_ENV=development

# Your deployed Vercel frontend URL (set on Render):
# FRONTEND_URL=https://your-app.vercel.app
